@baseUrl = https://localhost:7093
@contentType = application/json
@patchContentType = application/json-patch+json

GET {{baseUrl}}/api/Villa

###

@idx = 10
GET {{baseUrl}}/api/Villa/{{idx}}

###

POST {{baseUrl}}/api/Villa
Content-Type: {{contentType}}

{
  "nombre": "Villa de Laredo",
  "detalle": "Detalle de la Villa Maria",
  "tarifa": 200.0,
  "ocupantes": 4,
  "metroscuadrados": 500,
  "imagenurl": "https://example.com/villa-fatima.jpg",
  "amenidad": "Piscina privada"
}

###

@ida = 10
PUT {{baseUrl}}/api/Villa/{{ida}}
Content-Type: {{contentType}}

{
  "id": {{ida}},
  "nombre":"Villa La Esperanza",
  "detalle": "Detalle de la Villa Maria",
  "tarifa": 200.0,
  "ocupantes": 4,
  "metroscuadrados": 500,
  "imagenurl": "https://example.com/villa-fatima.jpg",
  "amenidad": "Piscina privada"
}

###
@idy = 3
DELETE {{baseUrl}}/api/Villa/{{idy}}
Accept: {{contentType}}

###
@idz = 10
PATCH {{baseUrl}}/api/Villa/{{idz}}
Content-Type: {{patchContentType}}

[
  { "op": "replace", "path": "/tarifa", "value": "250.00" },
  { "op": "replace", "path": "/amenidad", "value": "Jacuzzi" }
]

